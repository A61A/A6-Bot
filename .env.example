# ---- Discord bot credentials (Developer Portal) ----
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# ---- Server to operate on + member role auto-assigned on join ----
# Right-click your server icon > Copy Server ID
GUILD_ID=
BASE_ROLE_ID=
BASE_ROLE_NAME=Member

# ---- Channel IDs (right-click channel > Copy Channel ID) ----
WELCOME_CHANNEL_ID=
ROLE_SELECT_CHANNEL_ID=
KIOSK_CHANNEL_ID=
ANNOUNCEMENTS_CHANNEL_ID=
MOD_LOG_CHANNEL_ID=
# Category that support ticket channels are created under
SUPPORT_CATEGORY_ID=

# ---- Roles ----
SHOPPER_ROLE_ID=
INF_ROLE_ID=
# Comma-separated user IDs always treated as staff/admin
ADMIN_USER_IDS=
# Owner user ID - only owner/staff get /sync and similar owner commands
OWNER_USER_ID=

# Emoji shown on the role-picker buttons
ROLE_EMOJI_SHOPPER=1️⃣
ROLE_EMOJI_RESELLER=2️⃣

# ---- AI support (Gemini preferred, OpenAI fallback) ----
# Get a free Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
OPENAI_API_KEY=

# ---- Crypto checkout (picked plisio > nowpayments > simulator) ----
# 1. PLISIO_API_KEY     -> Plisio (hosted invoice; no minimum amount)
# 2. NOWPAYMENTS_API_KEY -> NowPayments (inline address)
# 3. neither             -> simulator mode (auto-completes ~16s) for testing
PLISIO_API_KEY=
NOWPAYMENTS_API_KEY=
PAYMENT_CURRENCY=btc