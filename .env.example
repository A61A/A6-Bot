# ---- Discord bot credentials (Developer Portal) ----
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# ---- Server to operate on + member role auto-assigned on join ----
# Right-click your server icon > Copy Server ID
GUILD_ID=
BASE_ROLE_ID=
BASE_ROLE_NAME=Member

# ---- Channel IDs (right-click channel > Copy Channel ID) ----
WELCOME_CHANNEL_ID=
ROLE_SELECT_CHANNEL_ID=
KIOSK_CHANNEL_ID=
ANNOUNCEMENTS_CHANNEL_ID=
MOD_LOG_CHANNEL_ID=
# Category that support ticket channels are created under
SUPPORT_CATEGORY_ID=

# ---- Roles ----
SHOPPER_ROLE_ID=
INF_ROLE_ID=
# Comma-separated user IDs always treated as staff/admin
ADMIN_USER_IDS=
# Owner user ID - only owner/staff get /sync and similar owner commands
OWNER_USER_ID=

# Emoji shown on the role-picker buttons
ROLE_EMOJI_SHOPPER=1️⃣
ROLE_EMOJI_RESELLER=2️⃣

# ---- Brand + bottom shop block on every embed ----
# Short brand prefix used in embed titles ("A6 ・ How To Use A6")
BRAND_SHORT=A6
# Links shown in the "Shop" block at the bottom of embeds.
# Leave any of these empty and that link is dropped automatically.
SHOP_URL=
SHOP_PRICING_URL=
SHOP_DASHBOARD_URL=
SHOP_SUPPORT_URL=
# Optional one-liner above the links, e.g. "Open 24/7 - instant delivery"
SHOP_FOOTER_NOTE=
# Telegram invite used by the site panel (defaults to https://t.me/a61ahub)
TELEGRAM_URL=

# ---- Kiosk panel (Components V2, posted with /kiosk) ----
# Channel the kiosk panel is posted to
# KIOSK_CHANNEL_ID is already listed above under Channel IDs
# Optional copy overrides - defaults live in cogs/kiosk.py
KIOSK_TITLE=
KIOSK_DESCRIPTION=
KIOSK_FOOTER=
SITEKIOSK_TITLE=

# ---- AI support (Gemini preferred, OpenAI fallback) ----
# Get a free Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
OPENAI_API_KEY=

# ---- Crypto checkout (picked plisio > nowpayments > simulator) ----

# ---- Persistence (Railway) ----
# Railway wipes the filesystem on every deploy, which resets credits,
# purchases and the catalog. Fix: create a Volume mounted at /data and set:
# DATA_DIR=/data
# (Leave empty locally - the bot uses ./data instead.)
DATA_DIR=# 1. PLISIO_API_KEY     -> Plisio (hosted invoice; no minimum amount)
# 2. NOWPAYMENTS_API_KEY -> NowPayments (inline address)
# 3. neither             -> simulator mode (auto-completes ~16s) for testing
PLISIO_API_KEY=
NOWPAYMENTS_API_KEY=
PAYMENT_CURRENCY=btc