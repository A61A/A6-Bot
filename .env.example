DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DATABASE_URL=postgresql://user:password@localhost:5432/discordbot
ANTHROPIC_API_KEY=
GUILD_ID=

# Channel IDs — right-click a channel in Discord (Developer Mode on) > Copy Channel ID
WELCOME_CHANNEL_ID=
ROLE_SELECT_CHANNEL_ID=
ANNOUNCEMENTS_CHANNEL_ID=
MOD_LOG_CHANNEL_ID=

# Role every new member gets automatically on join, before they pick a specialty
BASE_ROLE_NAME=Member
KIOSK_CHANNEL_ID=

# Crypto checkout. Providers are picked in this order:
#   1. PLISIO_API_KEY  → Plisio (link-based hosted invoice; no minimum amount)
#   2. NOWPAYMENTS_API_KEY → NowPayments (inline QR + address; ~$8 min for XMR)
#   3. neither         → simulator mode (auto-completes after ~16s) for testing.
# PAYMENT_CURRENCY is the crypto customers pay in (lowercase, e.g. xmr).
PLISIO_API_KEY=
NOWPAYMENTS_API_KEY=
PAYMENT_CURRENCY=xmr